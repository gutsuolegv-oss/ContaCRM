# Copiază în .env și completează. .env NU se pune în git (este în .gitignore).

# --- Baza de date ---
POSTGRES_USER=contacrm
POSTGRES_PASSWORD=schimba-ma
POSTGRES_DB=contacrm

# --- Aplicație ---
# Generare: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# IP-ul serverului în rețeaua biroului, pe care se publică portul 443
OFFICE_BIND_IP=127.0.0.1

# --- Gateway notificări ---
# Cheie partajată worker ↔ gateway (generează la fel ca APP_SECRET_KEY)
GATEWAY_API_KEY=
# Doar gateway-ul primește tokenul botului (de la @BotFather)
TELEGRAM_BOT_TOKEN=
GATEWAY_RATE_LIMIT_PER_MINUTE=30

# --- Email (trimis de gateway prin proxy) ---
# Domeniul trebuie adăugat și în infra/egress-proxy/squid.conf (acl smtp_relay)
SMTP_HOST=smtp.example.md
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ContaCRM <notificari@birou.md>
